
#include <WiFi.h>
#include <HTTPClient.h>
#include <Wire.h>
#include "MAX30105.h"
#include "heartRate.h"
#include <HardwareSerial.h>

// ================= WIFI SETTINGS =================

const char* ssid = "YOUR_WIFI_NAME";
const char* password = "YOUR_WIFI_PASSWORD";

// Change this to your computer's IPv4 address
const char* serverURL =
"http://192.168.1.10/school_form_fixed_files/api_receive.php";

const char* apiKey = "MY_SECRET_123";

// ================= GSM SETTINGS =================

HardwareSerial gsm(2);

const char* emergencyNumber = "+250780986245";

const int GSM_RX = 16;
const int GSM_TX = 17;

// ================= HEART SENSOR =================

MAX30105 particleSensor;

const int LOW_BPM_LIMIT = 40;
const int RESET_BPM_LIMIT = 45;

const byte RATE_SIZE = 4;
byte rates[RATE_SIZE];
byte rateSpot = 0;

long lastBeat = 0;

float beatsPerMinute;
int beatAvg = 0;

// ================= ALERT SETTINGS =================

int lowReadingCount = 0;
bool alertSent = false;

const int REQUIRED_LOW_READINGS = 3;

// ================= SETUP =================

void setup() {

  Serial.begin(115200);

  Wire.begin(21, 22);

  // Connect WiFi
  WiFi.begin(ssid, password);

  Serial.print("Connecting to WiFi");

  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }

  Serial.println("\nWiFi connected!");

  Serial.println(WiFi.localIP());

  // Start GSM
  gsm.begin(9600, SERIAL_8N1, GSM_RX, GSM_TX);

  delay(2000);

  gsm.println("AT");
  delay(1000);

  gsm.println("AT+CMGF=1");
  delay(1000);

  Serial.println("GSM initialized");

  // Start MAX30102
  if (!particleSensor.begin(Wire, I2C_SPEED_STANDARD)) {

    Serial.println("MAX30102 not found!");

    while (1) {
      delay(1000);
    }
  }

  particleSensor.setup();

  particleSensor.setPulseAmplitudeRed(0x0A);
  particleSensor.setPulseAmplitudeIR(0x1F);

  Serial.println("Heartbeat sensor ready!");
}

// ================= SEND DATA TO PHP =================

void sendToDashboard(int bpm) {

  if (WiFi.status() != WL_CONNECTED) {
    return;
  }

  HTTPClient http;

  http.begin(serverURL);

  http.addHeader("Content-Type", "application/json");
  http.addHeader("X-API-Key", apiKey);

  String json = "{\"bpm\":" + String(bpm) + "}";

  int response = http.POST(json);

  Serial.print("Dashboard response: ");
  Serial.println(response);

  http.end();
}

// ================= SEND SMS =================

void sendSMS(String message) {

  gsm.println("AT+CMGF=1");
  delay(500);

  gsm.print("AT+CMGS=\"");
  gsm.print(emergencyNumber);
  gsm.println("\"");

  delay(1000);

  gsm.print(message);
  delay(500);

  gsm.write(26);

  delay(3000);

  Serial.println("SMS command sent");
}

// ================= MAKE PHONE CALL =================

void makeEmergencyCall() {

  Serial.println("Calling emergency number...");

  gsm.print("ATD");
  gsm.print(emergencyNumber);
  gsm.println(";");

  delay(20000);

  gsm.println("ATH");

  Serial.println("Emergency call ended");
}

// ================= CHECK HEARTBEAT =================

void checkHeartbeat(int bpm) {

  if (bpm <= LOW_BPM_LIMIT && bpm > 0) {

    lowReadingCount++;

    Serial.print("Low BPM count: ");
    Serial.println(lowReadingCount);

    if (lowReadingCount >= REQUIRED_LOW_READINGS
        && !alertSent) {

      alertSent = true;

      Serial.println("CRITICAL HEARTBEAT ALERT!");

      sendSMS(
        "HEARTBEAT ALERT! BPM is 40 or below. Please check immediately."
      );

      makeEmergencyCall();
    }

  } else if (bpm > RESET_BPM_LIMIT) {

    lowReadingCount = 0;
    alertSent = false;
  }
}

// ================= MAIN LOOP =================

void loop() {

  long irValue = particleSensor.getIR();

  // Check that a finger is placed on the sensor
  if (irValue < 50000) {

    Serial.println("Place your finger on the sensor");

    lowReadingCount = 0;

    delay(500);

    return;
  }

  if (checkForBeat(irValue)) {

    long currentTime = millis();

    long delta = currentTime - lastBeat;

    lastBeat = currentTime;

    if (delta > 0) {

      beatsPerMinute = 60.0 / (delta / 1000.0);

      if (beatsPerMinute > 30 &&
          beatsPerMinute < 220) {

        rates[rateSpot++] = (byte)beatsPerMinute;

        rateSpot %= RATE_SIZE;

        beatAvg = 0;

        for (byte i = 0; i < RATE_SIZE; i++) {
          beatAvg += rates[i];
        }

        beatAvg /= RATE_SIZE;

        Serial.print("Heartbeat: ");
        Serial.print(beatAvg);
        Serial.println(" BPM");

        sendToDashboard(beatAvg);

        checkHeartbeat(beatAvg);
      }
    }
  }

  delay(20);
}
